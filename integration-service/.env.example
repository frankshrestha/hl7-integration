DATABASE_URL=postgresql://localhost:5432/hl7_int
HTTP_HOST=127.0.0.1
HTTP_PORT=8085

LOCAL_APPLICATION=HL7_INT
LOCAL_FACILITY=

HL7_API_URL=http://localhost:8000/api/integrations/lab-results
HL7_API_TIMEOUT_SECONDS=10

HL7_INT_CLIENT_ID=hl7-service
# Shared secret used to sign requests; must match the Laravel API configuration.
HL7_API_HMAC_SECRET=change-me

# Max attempts per message before it is dead-lettered.
DELIVERY_MAX_ATTEMPTS=12
# Retry delay
DELIVERY_BACKOFF_BASE_SECONDS=5
DELIVERY_BACKOFF_CAP_SECONDS=300
# Time a worker owns a claimed message
DELIVERY_LEASE_SECONDS=60
# Messages claimed per poll and sent concurrently.
DELIVERY_BATCH_SIZE=20
# Time the worker sleeps when no message is due.
DELIVERY_POLL_INTERVAL_SECONDS=1

BATCH_MAX_RECORDS=300

LOG_LEVEL=INFO
